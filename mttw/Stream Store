import { create } from "zustand"

type StreamState = {
  streams: string[]
  add: (c: string) => void
  remove: (c: string) => void
}

export const useStreamStore = create<StreamState>((set) => ({
  streams: ["shroud", "lirik", "xqc"],

  add: (c) =>
    set((s) => ({
      streams: [...s.streams, c]
    })),

  remove: (c) =>
    set((s) => ({
      streams: s.streams.filter(
        (x) => x !== c
      )
    }))
}))
